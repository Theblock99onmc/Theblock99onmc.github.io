    <link href="https://cdn.jsdelivr.net/npm/open-dyslexic-styling@1.0.2/open-dyslexic/style.css" rel="stylesheet">
    
    <style>
        body.font-inter { font-family: 'Inter', sans-serif !important; }
        body.font-lexend { font-family: 'Lexend', sans-serif !important; }
        body.font-dyslexic { font-family: 'OpenDyslexic', 'Inter', sans-serif !important; }

        html.oled-dark,
        html.oled-dark body {
            background-color: #000000 !important;
            color: #ffffff !important;
        }

        html.oled-dark .bg-white,
        html.oled-dark .bg-slate-800,
        html.oled-dark .bg-slate-900,
        html.oled-dark .bg-gray-50,
        html.oled-dark .bg-gray-100 {
            background-color: #000000 !important;
            border-color: #262626 !important;
            color: #ffffff !important;
        }

        button:focus-visible, 
        a:focus-visible, 
        input:focus-visible,
        select:focus-visible {
            outline: 3px solid #6366f1 !important;
            outline-offset: 3px !important;
        }

        /* ===== KUBUS FUSIE STYLES ===== */
        .kb-stage { background: linear-gradient(165deg, #3730a3 0%, #1e1b4b 55%, #0b1020 100%); border: 3px solid #6366f1; border-radius: 1.75rem; padding: 1.25rem; color: #fff; box-shadow: 0 24px 48px -16px rgba(49, 46, 129, .6); display: flex; flex-direction: column; gap: 1rem; }
        .kb-top { display: flex; align-items: center; justify-content: space-between; gap: .75rem; flex-wrap: wrap; }
        .kb-coinbox { display: flex; align-items: center; gap: .6rem; background: rgba(15, 23, 42, .6); border: 2px solid rgba(251, 191, 36, .45); border-radius: 1.1rem; padding: .45rem .9rem; }
        .kb-coin-icon { font-size: 1.9rem; line-height: 1; }
        .kb-label { margin: 0; font-size: .7rem; font-weight: 800; letter-spacing: .08em; text-transform: uppercase; color: #c7d2fe; }
        .kb-coin { font-family: ui-monospace, SFMono-Regular, Menlo, Consolas, monospace; font-weight: 900; font-size: 1.8rem; line-height: 1.05; color: #fcd34d; text-shadow: 0 2px 0 #92400e; }
        .kb-btn { background: #6366f1; color: #fff; font-weight: 800; font-size: .8rem; padding: .55rem 1rem; border-radius: .9rem; border: 0; border-bottom: 4px solid #3730a3; cursor: pointer; transition: transform .08s, filter .15s; }
        .kb-btn:hover { filter: brightness(1.12); }
        .kb-btn:active { transform: translateY(2px); border-bottom-width: 2px; }
        .kb-panel { background: rgba(15, 23, 42, .55); border: 2px solid rgba(129, 140, 248, .35); border-radius: 1.25rem; padding: 1rem; display: flex; flex-direction: column; gap: .75rem; }
        
        .kb-grid { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 10px; position: relative; }
        .kb-shop-grid { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 10px; position: relative; }
        .kb-col-hover { background: rgba(129, 140, 248, 0.15); border-radius: 0.75rem; }
        .kb-slot { height: 78px; display: flex; align-items: center; justify-content: center; position: relative; background: rgba(255, 255, 255, .05); border: 2px dashed rgba(165, 180, 252, .22); border-radius: 1rem; }
        
        /* CUBE APPEARANCE */
        .kb-cube { position: relative; display: flex; flex-direction: column; align-items: center; justify-content: center; width: 62px; height: 62px; border-radius: 1rem; border: 0; cursor: pointer; user-select: none; box-shadow: inset 0 -6px 0 rgba(0, 0, 0, .25), inset 0 4px 0 rgba(255, 255, 255, .35), 0 8px 12px rgba(0, 0, 0, .4); transition: transform .15s ease, filter .15s; }
        .kb-cube::after { content: ""; position: absolute; top: 8%; left: 12%; width: 26%; height: 12%; border-radius: 999px; background: rgba(255, 255, 255, .5); transform: rotate(-20deg); }
        .kb-cube:hover { transform: scale(1.06); z-index: 20; }
        
        .kb-cube-type-1 { background: linear-gradient(135deg, #3b82f6, #1d4ed8); color: #ffffff; }
        .kb-cube-type-2 { background: linear-gradient(135deg, #10b981, #047857); color: #ffffff; }
        .kb-cube-type-3 { background: linear-gradient(135deg, #f59e0b, #b45309); color: #ffffff; }
        .kb-cube-type-4 { background: linear-gradient(135deg, #ef4444, #b91c1c); color: #ffffff; }
        .kb-cube-type-5 { background: linear-gradient(135deg, #a855f7, #6b21a8); color: #ffffff; }
        .kb-cube-type-6 { background: linear-gradient(135deg, #ec4899, #be185d); color: #ffffff; }
        .kb-cube-type-7 { background: linear-gradient(135deg, #06b6d4, #0e7490); color: #ffffff; }
        .kb-cube-type-8 { background: linear-gradient(135deg, #eab308, #854d0e); color: #ffffff; }
        .kb-cube-type-9 { background: linear-gradient(135deg, #84cc16, #4d7c0f); color: #ffffff; }
        .kb-cube-type-10 { background: linear-gradient(135deg, #6366f1, #3730a3); color: #ffffff; }
        
        .kb-cube-rainbow { 
            background: linear-gradient(45deg, #ff0000, #ff7f00, #ffff00, #00ff00, #0000ff, #4b0082, #9400d3);
            background-size: 300% 300%;
            animation: rainbowBg 3s ease infinite;
            color: #ffffff;
            border: 2px solid #ffffff;
        }
        @keyframes rainbowBg { 0% {background-position: 0% 50%;} 50% {background-position: 100% 50%;} 100% {background-position: 0% 50%;} }

        .kb-cube-val { font-weight: 900; font-size: 1.1rem; text-shadow: 0 2px 4px rgba(0,0,0,0.5); z-index: 2; line-height: 1; }
        .kb-cube-lvl-tag { font-size: 0.62rem; font-weight: 800; opacity: 0.9; text-transform: uppercase; z-index: 2; }

        .kb-eyes { display: flex; gap: 6px; margin-bottom: 2px; z-index: 2; }
        .kb-eye { position: relative; width: 10px; height: 12px; background: #fff; border-radius: 50%; }
        .kb-pupil { position: absolute; width: 5px; height: 5px; left: 2px; top: 3px; background: #0f172a; border-radius: 50%; }

        @keyframes kbFall { from { transform: translateY(-120px); opacity: 0.3; } to { transform: translateY(0); opacity: 1; } }
        .kb-fall { animation: kbFall .25s cubic-bezier(.34, 1.56, .64, 1) forwards; }
        
        @keyframes kbPop { 0% { transform: scale(0.6); } 50% { transform: scale(1.25); } 100% { transform: scale(1); } }
        .kb-pop { animation: kbPop .3s ease-out forwards; }

        .kb-selected-cube { outline: 4px solid #fcd34d; outline-offset: 4px; transform: scale(1.1); z-index: 30; box-shadow: 0 0 20px rgba(252, 211, 77, 0.6) !important; }

        .kb-shop-item { border: 2px solid rgba(255,255,255,0.15); background: rgba(15, 23, 42, 0.6); border-radius: 1rem; padding: 0.5rem; display: flex; flex-direction: column; align-items: center; gap: 0.25rem; transition: all 0.15s ease; cursor: pointer; }
        .kb-shop-item:hover { border-color: #818cf8; background: rgba(30, 41, 59, 0.8); transform: translateY(-2px); }

        .kb-fx-float { position: absolute; font-weight: 900; font-size: 0.95rem; color: #fcd34d; text-shadow: 0 2px 4px rgba(0,0,0,0.8); pointer-events: none; animation: kbFloat 0.8s ease-out forwards; z-index: 50; }
        @keyframes kbFloat { 0% { transform: translateY(0) scale(0.8); opacity: 1; } 100% { transform: translateY(-40px) scale(1.2); opacity: 0; } }
    </style>
</head>
