        <!-- MATH QUIZ MODAL FOR FREE COINS -->
        <div id="math-quiz-modal" class="hidden fixed inset-0 bg-slate-950/80 backdrop-blur-sm z-50 flex items-center justify-center p-4">
            <div class="bg-slate-900 border-2 border-indigo-500/50 rounded-3xl p-6 max-w-md w-full text-center space-y-4 shadow-2xl">
                <div class="text-4xl">🧠</div>
                <h3 class="text-xl font-black text-white">Reken-Bonus Som</h3>
