            <div class="bg-white dark:bg-slate-800 rounded-3xl p-6 shadow-xl border border-slate-200 dark:border-slate-700 space-y-4">
                <h2 class="text-2xl font-black">🏆 Jouw Voortgang</h2>
                <div class="grid grid-cols-3 gap-3 text-center">
                    <div class="p-4 bg-slate-100 dark:bg-slate-900 rounded-2xl">
                        <div class="text-xs text-slate-500">Streak</div>
