                    boxShadow: {
                        'glow-purple': '0 0 25px -5px rgba(168, 85, 247, 0.4)',
                        'glow-amber': '0 0 25px -5px rgba(245, 158, 11, 0.4)',
                        'glow-emerald': '0 0 25px -5px rgba(16, 185, 129, 0.4)',
                        'glow-blue': '0 0 25px -5px rgba(59, 130, 246, 0.4)',
                    }
                }
            }
        }
