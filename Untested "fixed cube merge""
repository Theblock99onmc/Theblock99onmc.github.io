                    <div class="p-4 bg-slate-100 dark:bg-slate-900 rounded-2xl">
                        <div class="text-xs text-slate-500">Totaal XP</div>
                        <div class="text-2xl font-bold text-indigo-500">1,450 XP</div>
                    </div>
                    <div class="p-4 bg-slate-100 dark:bg-slate-900 rounded-2xl">
                        <div class="text-xs text-slate-500">Munten</div>
                        <div id="voortgang-coins-val" class="text-2xl font-bold text-emerald-500">100</div>
                    </div>
                </div>
                <button onclick="resetToHub()" class="px-4 py-2 bg-indigo-600 text-white font-bold rounded-xl text-xs">Terug naar Home</button>
            </div>
        </section>
