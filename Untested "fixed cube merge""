    <!-- FOOTER -->
    <footer class="w-full bg-white dark:bg-slate-900 border-t border-slate-200 dark:border-slate-800 py-4 px-4 text-center text-xs text-slate-500">
        Math & Reken Hub © 2026 — Toegankelijk & Educatief Rekenplatform
    </footer>

    <script>
        /* ==========================================================================
           GLOBAL APPLICATION STATE
           ========================================================================== */
        let userStats = {
            streak: 5,
            xp: 1450,
            coins: 100
        };

        let currentView = 'hub-view';

        function showView(viewId) {
            const views = ['hub-view', 'setup-view', 'kubus-view', 'theorie-view', 'voortgang-view'];
            views.forEach(id => {
                const el = document.getElementById(id);
                if (el) el.classList.add('hidden');
            });
            const target = document.getElementById(viewId);
            if (target) target.classList.remove('hidden');
            currentView = viewId;
            updateGlobalUI();
        }

        function resetToHub() {
            showView('hub-view');
        }

        function updateGlobalUI() {
            document.getElementById('user-streak-val').textContent = `${userStats.streak} Dagen`;
            document.getElementById('user-xp-val').textContent = `${userStats.xp.toLocaleString()} XP`;
            document.getElementById('global-coin-val').textContent = userStats.coins;
            
            const voortgangCoin = document.getElementById('voortgang-coins-val');
            if (voortgangCoin) voortgangCoin.textContent = userStats.coins;
        }

        /* ==========================================================================
           KUBUS FUSIE ENGINE (COLUMN STACKING & SHOP REFILL FIXES)
           ========================================================================== */
        const KUBUS_COLS = 4;
        const KUBUS_ROWS = 4;
        const SHOP_ROWS = 2;

        // 4x4 Grid Board: board[row][col] (null or cube object)
        let kbBoard = Array(KUBUS_ROWS).fill(null).map(() => Array(KUBUS_COLS).fill(null));

        // 2x4 Shop Options
        let kbShop = Array(SHOP_ROWS).fill(null).map(() => Array(KUBUS_COLS).fill(null));

        let quizAnswer = null;
        let lastQuizTime = 0;
        const QUIZ_COOLDOWN_MS = 5 * 60 * 1000;
        let selectedBoardCube = null;

        function startKubus() {
            showView('kubus-view');
            initShop();
            renderKubusShop();
            renderKubusBoard();
        }

        function initShop() {
            for (let r = 0; r < SHOP_ROWS; r++) {
                for (let c = 0; c < KUBUS_COLS; c++) {
                    refillShopSlot(r, c);
                }
            }
        }

        function renderKubusShop() {
            const container = document.getElementById('kb-shop-grid');
            if (!container) return;
            container.innerHTML = '';

            for (let r = 0; r < SHOP_ROWS; r++) {
                for (let c = 0; c < KUBUS_COLS; c++) {
                    const item = kbShop[r][c];
                    const shopCard = document.createElement('div');
                    shopCard.className = `kb-shop-item col-slot-${c}`;
                    shopCard.onclick = () => buyAndDropCube(r, c);
                    shopCard.onmouseenter = () => highlightCol(c);
                    shopCard.onmouseleave = () => unhighlightCol();

                    const visualType = ((item.type - 1) % 10) + 1;
                    const cubeClass = item.isRainbow ? 'kb-cube-rainbow' : `kb-cube-type-${visualType}`;

                    shopCard.innerHTML = `
                        <div class="kb-cube ${cubeClass}" style="width: 42px; height: 42px;">
                            <div class="kb-eyes" style="margin-bottom: 0;">
                                <span class="kb-eye" style="width: 8px; height: 10px;"><span class="kb-pupil" style="width: 4px; height: 4px; left: 1px; top: 2px;"></span></span>
                                <span class="kb-eye" style="width: 8px; height: 10px;"><span class="kb-pupil" style="width: 4px; height: 4px; left: 1px; top: 2px;"></span></span>
                            </div>
                            <span class="kb-cube-val" style="font-size: 0.9rem;">T${item.type}</span>
                        </div>
                        <div class="text-center">
                            <span class="text-[9px] uppercase font-extrabold text-indigo-300 block leading-none">Lvl ${item.level}</span>
                            <span class="text-[11px] font-black text-amber-300">🪙 ${item.cost}</span>
                        </div>
                    `;
                    container.appendChild(shopCard);
                }
            }

            document.getElementById('kb-coin-counter').textContent = userStats.coins;
        }

        function renderKubusBoard() {
            const boardEl = document.getElementById('kb-grid-board');
            if (!boardEl) return;
            boardEl.innerHTML = '';

            for (let r = 0; r < KUBUS_ROWS; r++) {
                for (let c = 0; c < KUBUS_COLS; c++) {
                    const slot = document.createElement('div');
                    slot.className = `kb-slot col-slot-${c}`;
                    slot.onclick = () => handleBoardClick(r, c);
                    
                    const cubeData = kbBoard[r][c];
                    if (cubeData) {
                        const cube = document.createElement('div');
                        const visualType = ((cubeData.type - 1) % 10) + 1;
                        const cubeClass = cubeData.isRainbow ? 'kb-cube-rainbow' : `kb-cube-type-${visualType}`;
                        
                        let selectedClass = '';
                        if (selectedBoardCube && selectedBoardCube.r === r && selectedBoardCube.c === c) {
                            selectedClass = 'kb-selected-cube';
                        }

                        cube.className = `kb-cube ${cubeClass} ${cubeData.isNew ? 'kb-fall' : ''} ${selectedClass}`;
                        cubeData.isNew = false;

                        cube.innerHTML = `
                            <div class="kb-eyes">
                                <span class="kb-eye"><span class="kb-pupil"></span></span>
                                <span class="kb-eye"><span class="kb-pupil"></span></span>
                            </div>
                            <span class="kb-cube-val">T${cubeData.type}</span>
                            <span class="kb-cube-lvl-tag">Lvl ${cubeData.level}</span>
                        `;
                        slot.appendChild(cube);
                    }
                    boardEl.appendChild(slot);
                }
            }
        }

        function highlightCol(colIndex) {
            const slots = document.querySelectorAll(`.col-slot-${colIndex}`);
            slots.forEach(slot => slot.classList.add('kb-col-hover'));
        }

        function unhighlightCol() {
            const slots = document.querySelectorAll('.kb-slot, .kb-shop-item');
            slots.forEach(slot => slot.classList.remove('kb-col-hover'));
        }

        function buyAndDropCube(shopRow, col) {
            const shopItem = kbShop[shopRow][col];
            if (!shopItem) return;

            if (userStats.coins < shopItem.cost) {
                showStatusMsg(`⚠️ Niet genoeg munten! Je hebt 🪙 ${shopItem.cost} nodig. Klik op "Verdien Munten".`, true);
                return;
            }

            let targetRow = -1;
            for (let r = KUBUS_ROWS - 1; r >= 0; r--) {
                if (kbBoard[r][col] === null) {
                    targetRow = r;
                    break;
                }
            }

            if (targetRow === -1) {
                showStatusMsg(`⚠️ Kolom is vol! Kies een andere kolom of laat cubes fuseren.`, true);
                return;
            }

            userStats.coins -= shopItem.cost;
            updateGlobalUI();

            const newCube = {
                level: shopItem.level,
                type: shopItem.type,
                isRainbow: shopItem.isRainbow,
                isNew: true
            };
            kbBoard[targetRow][col] = newCube;

            showStatusMsg(`✅ Kubus (Type ${shopItem.type}, Lvl ${shopItem.level}) geplaatst!`);

            refillShopSlot(shopRow, col);
            executeFusionLogic(targetRow, col);

            renderKubusShop();
            renderKubusBoard();
        }

        function refillShopSlot(shopRow, col) {
            // 1% kans op een regenboog kubus
            const isRainbow = Math.random() < 0.01;
            
            let type, level, cost;

            if (isRainbow) {
                type = 1;
                level = 10;
                cost = 10;
            } else {
                type = Math.floor(Math.random() * 10) + 1;
                level = 1;
                cost = 10; // Vaste kosten voor reguliere drops om de balans te behouden
            }

            kbShop[shopRow][col] = {
                id: Date.now() + Math.random(),
                level: level,
                type: type,
                cost: cost,
                isRainbow: isRainbow
            };
        }

        function executeFusionLogic(row, col) {
            let cube = kbBoard[row][col];
            if (!cube) return;

            // Fuseren vereist nu hetzelfde TYPE en hetzelfde LEVEL
            if (row < KUBUS_ROWS - 1) {
                const bottomCube = kbBoard[row + 1][col];
                if (bottomCube && bottomCube.type === cube.type && bottomCube.level === cube.level) {
                    const newLevel = cube.level + 1;
                    
                    kbBoard[row][col] = null;
                    kbBoard[row + 1][col] = {
                        level: newLevel,
                        type: cube.type,
                        isRainbow: cube.isRainbow || bottomCube.isRainbow,
                        isNew: true
                    };

                    // Nieuwe munten formule: (lvl * 10) / type
                    const bonusCoins = Math.floor((newLevel * 10) / cube.type);
                    userStats.coins += bonusCoins;
                    userStats.xp += newLevel * 20;
                    updateGlobalUI();

                    showStatusMsg(`🔥 FUSIE! Niveau ${newLevel} kubus gemaakt! (+🪙 ${bonusCoins})`);

                    applyGravity();
                    executeFusionLogic(row + 1, col);
                    return;
                }
            }

            const neighbors = [
                { r: row, c: col - 1 },
                { r: row, c: col + 1 }
            ];

            for (let n of neighbors) {
                if (n.c >= 0 && n.c < KUBUS_COLS) {
                    const adjCube = kbBoard[n.r][n.c];
                    if (adjCube && adjCube.type === cube.type && adjCube.level === cube.level) {
                        const newLevel = cube.level + 1;

                        kbBoard[n.r][n.c] = null;
                        kbBoard[row][col] = {
                            level: newLevel,
                            type: cube.type,
                            isRainbow: cube.isRainbow || adjCube.isRainbow,
                            isNew: true
                        };

                        const bonusCoins = Math.floor((newLevel * 10) / cube.type);
                        userStats.coins += bonusCoins;
                        userStats.xp += newLevel * 25;
                        updateGlobalUI();

                        showStatusMsg(`💥 KETTING FUSIE! Niveau ${newLevel} kubus gevormd! (+🪙 ${bonusCoins})`);

                        applyGravity();
                        executeFusionLogic(row, col);
                        break;
                    }
                }
            }
        }

        function handleBoardClick(r, c) {
            const clickedCube = kbBoard[r][c];

            // Als er nog niks geselecteerd is
            if (!selectedBoardCube) {
                if (clickedCube) {
                    selectedBoardCube = { r, c };
                    renderKubusBoard();
                }
                return;
            }

            const sr = selectedBoardCube.r;
            const sc = selectedBoardCube.c;

            // Klik op dezelfde kubus = deselecteren
            if (sr === r && sc === c) {
                selectedBoardCube = null;
                renderKubusBoard();
                return;
            }

            // Controleer of de nieuwe klik horizontaal of verticaal aangrenzend is
            const isAdjacent = (Math.abs(sr - r) === 1 && sc === c) || (Math.abs(sc - c) === 1 && sr === r);

            if (isAdjacent && clickedCube) {
                // Voer handmatige fusie uit!
                const firstCube = kbBoard[sr][sc];
                const secondCube = clickedCube;

                const newLevel = firstCube.level * secondCube.level;
                const newType = firstCube.type * secondCube.type;
                const isRainbow = firstCube.isRainbow || secondCube.isRainbow;

                // De nieuwe kubus komt op de positie van de tweede (laatst geklikte) kubus
                kbBoard[r][c] = {
                    level: newLevel,
                    type: newType,
                    isRainbow: isRainbow,
                    isNew: true
                };
                kbBoard[sr][sc] = null; // Verwijder de eerste kubus

                // Bereken munten volgens de door jou gekozen methode
                let formulaCoins = Math.max(1, Math.floor((newLevel * 10) / newType));

                userStats.coins += formulaCoins;
                userStats.xp += Math.max(10, formulaCoins);
                updateGlobalUI();

                showStatusMsg(`✨ HANDMATIGE FUSIE! Niveau ${newLevel} (Type ${newType})! (+🪙 ${formulaCoins})`);

                selectedBoardCube = null;
                applyGravity();
                renderKubusBoard();
            } else if (clickedCube) {
                // Klik op een andere, niet-aangrenzende kubus verandert de selectie
                selectedBoardCube = { r, c };
                renderKubusBoard();
            } else {
                // Klik in een lege ruimte deselecteert
                selectedBoardCube = null;
                renderKubusBoard();
            }
        }

        function applyGravity() {
            let moved = false;
            for (let c = 0; c < KUBUS_COLS; c++) {
                let writeIdx = KUBUS_ROWS - 1;
                // Schuif alles in deze kolom zo ver mogelijk naar beneden (handig na handmatige fusies)
                for (let r = KUBUS_ROWS - 1; r >= 0; r--) {
                    if (kbBoard[r][c] !== null) {
                        if (r !== writeIdx) {
                            kbBoard[writeIdx][c] = kbBoard[r][c];
                            kbBoard[r][c] = null;
                            moved = true;
                        }
                        writeIdx--;
                    }
                }
            }
            if (moved) renderKubusBoard();
        }

        function showStatusMsg(msg, isError = false) {
            const statusEl = document.getElementById('kb-status-msg');
            if (statusEl) {
                statusEl.textContent = msg;
                statusEl.style.color = isError ? '#f87171' : '#fde68a';
            }
        }

        function resetKubusGame() {
            kbBoard = Array(KUBUS_ROWS).fill(null).map(() => Array(KUBUS_COLS).fill(null));
            userStats.coins = 100;
            updateGlobalUI();
            initShop();
            renderKubusShop();
            renderKubusBoard();
            showStatusMsg("Spel gereset! Je hebt 100 beginmunten gekregen.");
        }

        /* ==========================================================================
           MATH QUIZ MODAL FOR EARNING EXTRA COINS
           ========================================================================== */
        function openMathQuizModal() {
            const now = Date.now();
            if (now - lastQuizTime < QUIZ_COOLDOWN_MS) {
                const remainingSecs = Math.ceil((QUIZ_COOLDOWN_MS - (now - lastQuizTime)) / 1000);
                const mins = Math.floor(remainingSecs / 60);
                const secs = remainingSecs % 60;
                showStatusMsg(`⏳ Reken-Bonus is op afkoelperiode! Wacht nog ${mins}m ${secs}s.`, true);
                return;
            }

            const a = Math.floor(Math.random() * 25) + 5;
            const b = Math.floor(Math.random() * 25) + 5;
            quizAnswer = a + b;
            
            document.getElementById('quiz-question').textContent = `${a} + ${b} = ?`;
            document.getElementById('quiz-input').value = '';
            document.getElementById('math-quiz-modal').classList.remove('hidden');
            setTimeout(() => document.getElementById('quiz-input').focus(), 100);
        }

        function closeMathQuizModal() {
            document.getElementById('math-quiz-modal').classList.add('hidden');
        }

        function submitMathQuiz(e) {
            e.preventDefault();
            const val = parseInt(document.getElementById('quiz-input').value, 10);
            if (val === quizAnswer) {
                userStats.coins += 50;
                userStats.xp += 15;
                lastQuizTime = Date.now(); // Start de 5-minuten timer
                updateGlobalUI();
                renderKubusShop();
                closeMathQuizModal();
                showStatusMsg("🎉 Goed berekend! +50 Munten toegevoegd!");
            } else {
                document.getElementById('quiz-question').textContent = "❌ Probeer opnieuw!";
                setTimeout(() => openMathQuizModal(), 1000);
            }
        }

        /* ==========================================================================
           ACCESSIBILITY & THEMING CONTROLS
           ========================================================================== */
        function toggleA11yMenu(e) {
            e.stopPropagation();
            const dropdown = document.getElementById('a11y-dropdown');
            dropdown.classList.toggle('hidden');
        }

        document.addEventListener('click', () => {
            const dropdown = document.getElementById('a11y-dropdown');
            if (dropdown && !dropdown.classList.contains('hidden')) {
                dropdown.classList.add('hidden');
            }
        });

        function setTheme(theme) {
            document.documentElement.classList.remove('dark', 'oled-dark');
            if (theme === 'dark') {
                document.documentElement.classList.add('dark');
            } else if (theme === 'oled') {
                document.documentElement.classList.add('dark', 'oled-dark');
            }
        }

        function setFont(font) {
            document.body.classList.remove('font-inter', 'font-lexend', 'font-dyslexic');
            document.body.classList.add(`font-${font}`);
        }

        function setLanguage(lang) {
            document.getElementById('lang-btn-nl').classList.toggle('bg-white', lang === 'nl');
            document.getElementById('lang-btn-en').classList.toggle('bg-white', lang === 'en');
        }

        function setupGame(type) {
            showView('setup-view');
        }

